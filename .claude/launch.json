{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "ux-studio",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/ux-redesign"
      ],
      "port": 8765
    }
  ]
}
