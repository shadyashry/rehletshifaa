{
  "realm": "rehletshifaa",
  "enabled": true,
  "displayName": "RehletShifaa",
  "loginTheme": "rehletshifaa",
  "emailTheme": "rehletshifaa",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar"],
  "defaultLocale": "en",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultRoles": ["PATIENT"],
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5)",
  "smtpServer": {
    "host": "${MAIL_HOST}",
    "port": "${MAIL_PORT}",
    "from": "${MAIL_FROM}",
    "fromDisplayName": "RehletShifaa",
    "auth": "${MAIL_AUTH}",
    "starttls": "${MAIL_STARTTLS}",
    "user": "${MAIL_USERNAME}",
    "password": "${MAIL_PASSWORD}"
  },
  "roles": {
    "realm": [
      {
        "name": "PATIENT"
      },
      {
        "name": "PATIENT_REPRESENTATIVE"
      },
      {
        "name": "COORDINATOR"
      },
      {
        "name": "COORDINATOR_LEAD"
      },
      {
        "name": "DOCTOR"
      },
      {
        "name": "OPERATIONS"
      },
      {
        "name": "OPERATIONS_LEAD",
        "composite": true,
        "composites": {
          "realm": [
            "OPERATIONS"
          ]
        }
      },
      {
        "name": "FINANCE"
      },
      {
        "name": "FINANCE_LEAD",
        "composite": true,
        "composites": {
          "realm": [
            "FINANCE"
          ]
        }
      },
      {
        "name": "CREDENTIALING_ADMIN"
      },
      {
        "name": "SYSTEM_ADMIN"
      },
      {
        "name": "AUDITOR"
      },
      {
        "name": "PATIENT_IDENTITY_REVIEWER",
        "description": "Reviews patient legal-identity proofing (distinct from practitioner CREDENTIALING_ADMIN)"
      },
      {
        "name": "rs-staff",
        "description": "Works on cases or the platform: signs in with a second factor (D1). Set by the platform when staff are invited.",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "webAuthnPolicyRpEntityName": "RehletShifaa",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyCreateTimeout": 60,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyAcceptableAaguids": [],
  "browserFlow": "rehletshifaa-browser",
  "authenticatorConfig": [
    {
      "alias": "rs-amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-hwk",
      "config": {
        "default.reference.value": "hwk",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-recovery",
      "config": {
        "default.reference.value": "mfa",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-otp-enrol",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-cond-staff",
      "config": {
        "condUserRole": "rs-staff",
        "negate": "false"
      }
    },
    {
      "alias": "rs-cond-no-second-factor",
      "config": {
        "flow_to_check": "rehletshifaa-second-factor",
        "check_result": "not-executed"
      }
    },
    {
      "alias": "rs-deny-direct-grant",
      "config": {
        "denyErrorMessage": "Sign in through the RehletShifaa website."
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "rehletshifaa-browser",
      "description": "Sign-in: password, then the second factor the person has (passkey, authenticator app or recovery code); staff without one enrol now",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "rehletshifaa-sign-in"
        }
      ]
    },
    {
      "alias": "rehletshifaa-sign-in",
      "description": "Password and second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "rs-amr-pwd"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "rehletshifaa-second-factor"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "rehletshifaa-staff-enrolment"
        }
      ]
    },
    {
      "alias": "rehletshifaa-second-factor",
      "description": "Anyone who has a second factor uses it, at every sign-in, from every client: passkey, authenticator app or a recovery code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorConfig": "rs-amr-hwk"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorConfig": "rs-amr-otp"
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 40,
          "authenticatorConfig": "rs-amr-recovery"
        }
      ]
    },
    {
      "alias": "rehletshifaa-staff-enrolment",
      "description": "Staff without a second factor set one up at this sign-in",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "rs-cond-staff"
        },
        {
          "authenticator": "conditional-sub-flow-executed",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "rs-cond-no-second-factor"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorConfig": "rs-amr-otp-enrol"
        }
      ]
    },
    {
      "alias": "rehletshifaa-direct-grant-denied",
      "description": "No password-only tokens: every token comes from the browser sign-in",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "rs-deny-direct-grant"
        }
      ]
    },
    {
      "alias": "rehletshifaa-reset-credentials",
      "description": "Password reset proves the second factor before the new password",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "reset-credentials-choose-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "reset-credential-email",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "rehletshifaa-reset-second-factor"
        },
        {
          "authenticator": "reset-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 40
        }
      ]
    },
    {
      "alias": "rehletshifaa-reset-second-factor",
      "description": "A reset never bypasses a second factor the person has",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 30
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 40
        }
      ]
    }
  ],
  "directGrantFlow": "rehletshifaa-direct-grant-denied",
  "resetCredentialsFlow": "rehletshifaa-reset-credentials",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN_ERROR",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "CUSTOM_REQUIRED_ACTION",
    "EXECUTE_ACTIONS",
    "SEND_RESET_PASSWORD",
    "CODE_TO_TOKEN_ERROR",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "clients": [
    {
      "clientId": "rehletshifaa-web",
      "protocolMappers": [
        {
          "name": "auth-time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        },
        {
          "name": "rehletshifaa-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rehletshifaa-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "name": "RehletShifaa Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${APP_ORIGIN}",
      "baseUrl": "${APP_ORIGIN}",
      "redirectUris": ["${APP_ORIGIN}/auth/callback"],
      "webOrigins": ["${APP_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_ORIGIN}/*"
      }
    },
    {
      "clientId": "staff-identity-admin",
      "name": "Staff identity provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "${STAFF_IDENTITY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-staff-identity-admin",
      "enabled": true,
      "serviceAccountClientId": "staff-identity-admin",
      "clientRoles": {"realm-management": ["manage-users", "view-realm", "view-users", "query-users"]}
    }
  ]
}

