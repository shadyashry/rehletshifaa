{
  "realm": "rehletshifaa",
  "enabled": true,
  "displayName": "RehletShifaa",
  "loginTheme": "rehletshifaa",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar"],
  "defaultLocale": "en",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultRoles": ["PATIENT"],
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5)",
  "smtpServer": {
    "host": "${MAIL_HOST}",
    "port": "${MAIL_PORT}",
    "from": "${MAIL_FROM}",
    "fromDisplayName": "RehletShifaa",
    "auth": "${MAIL_AUTH}",
    "starttls": "${MAIL_STARTTLS}",
    "user": "${MAIL_USERNAME}",
    "password": "${MAIL_PASSWORD}"
  },
  "roles": {
    "realm": [
      {"name": "PATIENT"},
      {"name": "PATIENT_REPRESENTATIVE"},
      {"name": "COORDINATOR"},
      {"name": "COORDINATOR_LEAD"},
      {"name": "DOCTOR"},
      {"name": "OPERATIONS"},
      {"name": "FINANCE"},
      {"name": "CREDENTIALING_ADMIN"},
      {"name": "SYSTEM_ADMIN"},
      {"name": "AUDITOR"}
    ]
  },
  "clients": [
    {
      "clientId": "rehletshifaa-web",
      "name": "RehletShifaa Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${APP_ORIGIN}",
      "baseUrl": "${APP_ORIGIN}",
      "redirectUris": ["${APP_ORIGIN}/auth/callback"],
      "webOrigins": ["${APP_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_ORIGIN}/*"
      }
    }
  ]
}

