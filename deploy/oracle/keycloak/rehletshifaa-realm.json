{
  "realm": "rehletshifaa",
  "enabled": true,
  "displayName": "RehletShifaa",
  "loginTheme": "rehletshifaa",
  "emailTheme": "rehletshifaa",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar"],
  "defaultLocale": "en",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultRoles": ["PATIENT"],
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5)",
  "smtpServer": {
    "host": "${MAIL_HOST}",
    "port": "${MAIL_PORT}",
    "from": "${MAIL_FROM}",
    "fromDisplayName": "RehletShifaa",
    "auth": "${MAIL_AUTH}",
    "starttls": "${MAIL_STARTTLS}",
    "user": "${MAIL_USERNAME}",
    "password": "${MAIL_PASSWORD}"
  },
  "roles": {
    "realm": [
      {"name": "PATIENT"},
      {"name": "PATIENT_REPRESENTATIVE"},
      {"name": "COORDINATOR"},
      {"name": "COORDINATOR_LEAD"},
      {"name": "DOCTOR"},
      {"name": "OPERATIONS"},
      {"name": "OPERATIONS_LEAD", "composite": true, "composites": {"realm": ["OPERATIONS"]}},
      {"name": "FINANCE"},
      {"name": "FINANCE_LEAD", "composite": true, "composites": {"realm": ["FINANCE"]}},
      {"name": "CREDENTIALING_ADMIN"},
      {"name": "SYSTEM_ADMIN"},
      {"name": "AUDITOR"},
      {"name": "PATIENT_IDENTITY_REVIEWER", "description": "Reviews patient legal-identity proofing (distinct from practitioner CREDENTIALING_ADMIN)"}
    ]
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "webAuthnPolicyRpEntityName": "RehletShifaa",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyCreateTimeout": 60,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyAcceptableAaguids": [],
  "browserFlow": "rehletshifaa-browser-step-up",
  "authenticatorConfig": [
    {
      "alias": "rehletshifaa-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "rehletshifaa-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "rehletshifaa-loa-3",
      "config": {
        "loa-condition-level": "3",
        "loa-max-age": "36000"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "rehletshifaa-browser-step-up",
      "description": "Browser sign-in with password, OTP MFA and WebAuthn passkey step-up levels",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "rehletshifaa-browser-authentication"
        }
      ]
    },
    {
      "alias": "rehletshifaa-browser-authentication",
      "description": "Ordered cumulative levels of authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "rehletshifaa-loa-1-flow"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "rehletshifaa-loa-2-flow"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "rehletshifaa-loa-3-flow"
        }
      ]
    },
    {
      "alias": "rehletshifaa-loa-1-flow",
      "description": "LoA 1: username and password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rehletshifaa-loa-1",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "rehletshifaa-loa-2-flow",
      "description": "LoA 2: time-based one-time password MFA",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rehletshifaa-loa-2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "rehletshifaa-loa-3-flow",
      "description": "LoA 3: WebAuthn passkey after password and OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rehletshifaa-loa-3",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "rehletshifaa-web",
      "name": "RehletShifaa Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${APP_ORIGIN}",
      "baseUrl": "${APP_ORIGIN}",
      "redirectUris": ["${APP_ORIGIN}/auth/callback"],
      "webOrigins": ["${APP_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_ORIGIN}/*"
      }
    },
    {
      "clientId": "staff-identity-admin",
      "name": "Staff identity provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "${STAFF_IDENTITY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-staff-identity-admin",
      "enabled": true,
      "serviceAccountClientId": "staff-identity-admin",
      "clientRoles": {"realm-management": ["manage-users", "view-realm", "view-users", "query-users"]}
    }
  ]
}

