{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MedicalDocumentObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:PutObjectTagging",
        "s3:GetObjectTagging",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET/medical/*"
    }
  ]
}

