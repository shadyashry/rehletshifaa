# Copy to .env on the VM and replace every replace-* value.
COMPOSE_PROJECT_NAME=rehletshifaa

# Four DNS A/AAAA records must point to the VM before the first deployment.
APP_DOMAIN=care.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
STORAGE_DOMAIN=storage.example.com
ACME_EMAIL=ops@example.com

# Keep these distinct. Generate secrets with: openssl rand -base64 48
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
APP_DB_NAME=rehletshifaa
APP_DB_USERNAME=rehletshifaa_app
APP_DB_PASSWORD=replace-with-a-long-random-app-database-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak_app
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-keycloak-database-password

KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-admin-password
CLAIM_TOKEN_PEPPER=replace-with-at-least-32-random-bytes

MINIO_ROOT_USER=storage-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-root-password
S3_ACCESS_KEY=rehletshifaa-app
S3_SECRET_KEY=replace-with-a-long-random-storage-application-secret
S3_BUCKET=medical-documents
S3_REGION=us-east-1

# Use a transactional SMTP provider on port 587 or 465; OCI blocks outbound port 25 by default.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@example.com
COORDINATOR_EMAIL=coordinator@example.com

# The backend expects an HTTPS provider endpoint and bearer token.
WHATSAPP_WEBHOOK_URL=https://provider.example.com/messages
WHATSAPP_TOKEN=replace-with-whatsapp-provider-token

# Create these for the APP_DOMAIN in Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET=replace-with-turnstile-secret

NEXT_PUBLIC_WHATSAPP_NUMBER=201010447898
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

CLAIM_TOKEN_EXPIRY_SECONDS=900
CLAIM_TOKEN_MAX_ATTEMPTS=5
UPLOAD_MAX_BYTES=15728640
UPLOAD_MAX_FILES_PER_CASE=25
UPLOAD_MAX_CASE_BYTES=104857600
PRESIGN_EXPIRY_SECONDS=300
CLAMAV_TIMEOUT_MILLISECONDS=20000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# backup.sh reads these on the VM. Keep the passphrase file outside the repository.
BACKUP_DIRECTORY=/var/backups/rehletshifaa
BACKUP_PASSPHRASE_FILE=/etc/rehletshifaa/backup-passphrase
