{
  "Rules": [
    {
      "ID": "expire-unconfirmed-uploads",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "medical/",
          "Tags": [{ "Key": "upload-state", "Value": "pending" }]
        }
      },
      "Expiration": { "Days": 1 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    }
  ]
}
