{
  "realm": "rehletshifaa",
  "enabled": true,
  "displayName": "RehletShifaa Local",
  "loginTheme": "rehletshifaa",
  "emailTheme": "rehletshifaa",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ar"
  ],
  "defaultLocale": "en",
  "verifyEmail": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@local.test",
    "fromDisplayName": "RehletShifaa",
    "auth": "false",
    "starttls": "false"
  },
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultRoles": [],
  "webAuthnPolicyRpEntityName": "RehletShifaa",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyCreateTimeout": 60,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyAcceptableAaguids": [],
  "browserFlow": "rehletshifaa-browser",
  "authenticatorConfig": [
    {
      "alias": "rs-amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-hwk",
      "config": {
        "default.reference.value": "hwk",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-recovery",
      "config": {
        "default.reference.value": "mfa",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-amr-otp-enrol",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "rs-cond-staff",
      "config": {
        "condUserRole": "rs-staff",
        "negate": "false"
      }
    },
    {
      "alias": "rs-cond-no-second-factor",
      "config": {
        "flow_to_check": "rehletshifaa-second-factor",
        "check_result": "not-executed"
      }
    },
    {
      "alias": "rs-deny-direct-grant",
      "config": {
        "denyErrorMessage": "Sign in through the RehletShifaa website."
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "rehletshifaa-browser",
      "description": "Sign-in: password, then the second factor the person has (passkey, authenticator app or recovery code); staff without one enrol now",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "rehletshifaa-sign-in"
        }
      ]
    },
    {
      "alias": "rehletshifaa-sign-in",
      "description": "Password and second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "rs-amr-pwd"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "rehletshifaa-second-factor"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "rehletshifaa-staff-enrolment"
        }
      ]
    },
    {
      "alias": "rehletshifaa-second-factor",
      "description": "Anyone who has a second factor uses it, at every sign-in, from every client: passkey, authenticator app or a recovery code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorConfig": "rs-amr-hwk"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorConfig": "rs-amr-otp"
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 40,
          "authenticatorConfig": "rs-amr-recovery"
        }
      ]
    },
    {
      "alias": "rehletshifaa-staff-enrolment",
      "description": "Staff without a second factor set one up at this sign-in",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "rs-cond-staff"
        },
        {
          "authenticator": "conditional-sub-flow-executed",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "rs-cond-no-second-factor"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorConfig": "rs-amr-otp-enrol"
        }
      ]
    },
    {
      "alias": "rehletshifaa-direct-grant-denied",
      "description": "No password-only tokens: every token comes from the browser sign-in",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "rs-deny-direct-grant"
        }
      ]
    },
    {
      "alias": "rehletshifaa-reset-credentials",
      "description": "Password reset proves the second factor before the new password",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "reset-credentials-choose-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "reset-credential-email",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "rehletshifaa-reset-second-factor"
        },
        {
          "authenticator": "reset-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 40
        }
      ]
    },
    {
      "alias": "rehletshifaa-reset-second-factor",
      "description": "A reset never bypasses a second factor the person has",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 30
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 40
        }
      ]
    }
  ],
  "directGrantFlow": "rehletshifaa-direct-grant-denied",
  "resetCredentialsFlow": "rehletshifaa-reset-credentials",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN_ERROR",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "CUSTOM_REQUIRED_ACTION",
    "EXECUTE_ACTIONS",
    "SEND_RESET_PASSWORD",
    "CODE_TO_TOKEN_ERROR",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "rs-staff",
        "description": "Works on cases or the platform: signs in with a second factor (D1). Set by the platform when staff are invited.",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "rehletshifaa-web",
      "name": "RehletShifaa Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://dev.rehletshifaa.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://dev.rehletshifaa.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "basic",
        "acr",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "auth-time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        },
        {
          "name": "rehletshifaa-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rehletshifaa-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "staff-identity-admin",
      "name": "Staff identity provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "local-only-staff-identity-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
