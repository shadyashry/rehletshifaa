{
  "realm": "rehletshifaa",
  "enabled": true,
  "displayName": "RehletShifaa Local",
  "loginTheme": "rehletshifaa",
  "emailTheme": "rehletshifaa",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ar"
  ],
  "defaultLocale": "en",
  "verifyEmail": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@local.test",
    "fromDisplayName": "RehletShifaa",
    "auth": "false",
    "starttls": "false"
  },
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultRoles": [],
  "webAuthnPolicyRpEntityName": "RehletShifaa",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyCreateTimeout": 60,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyAcceptableAaguids": [],
  "browserFlow": "rehletshifaa-browser-step-up",
  "authenticatorConfig": [
    {
      "alias": "rehletshifaa-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "rehletshifaa-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "600"
      }
    },
    {
      "alias": "rehletshifaa-loa-3",
      "config": {
        "loa-condition-level": "3",
        "loa-max-age": "600"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "rehletshifaa-browser-step-up",
      "description": "Browser sign-in with password, OTP MFA and WebAuthn passkey step-up levels",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "rehletshifaa-browser-authentication"
        }
      ]
    },
    {
      "alias": "rehletshifaa-browser-authentication",
      "description": "Ordered cumulative levels of authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "rehletshifaa-loa-1-flow"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "rehletshifaa-loa-2-flow"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "rehletshifaa-loa-3-flow"
        }
      ]
    },
    {
      "alias": "rehletshifaa-loa-1-flow",
      "description": "LoA 1: username and password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rehletshifaa-loa-1",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "rehletshifaa-loa-2-flow",
      "description": "LoA 2: time-based one-time password MFA",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rehletshifaa-loa-2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "rehletshifaa-loa-3-flow",
      "description": "LoA 3: WebAuthn passkey after password and OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rehletshifaa-loa-3",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "rehletshifaa-web",
      "name": "RehletShifaa Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://dev.rehletshifaa.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://dev.rehletshifaa.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "basic",
        "acr",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "auth-time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        },
        {
          "name": "rehletshifaa-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rehletshifaa-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "staff-identity-admin",
      "name": "Staff identity provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "local-only-staff-identity-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
